# Copia este archivo como .env y completa los valores reales.
# cp .env.example .env

# Token del bot de Telegram (obtenido de @BotFather). Es un secreto único por
# instancia; a qué chat_id se le notifica cada propiedad ahora se configura
# por propiedad (vía la API/app web), no acá.
TELEGRAM_BOT_TOKEN=

# Ruta al archivo SQLite compartido por el worker y la API. Opcional.
# Default: data/lindero.db
DB_PATH=

# Opcional: cada cuántos segundos el worker revisa si a alguna propiedad le
# toca correr. Default: 60. No confundir con la frecuencia de cada propiedad
# (hora fija o intervalo), que se define por propiedad, no acá.
LINDERO_TICK_SEGUNDOS=60
