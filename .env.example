# Copia este archivo como .env y completa los valores reales.
# cp .env.example .env

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID donde se enviarán las notificaciones (obtenido con get_chat_id.py)
TELEGRAM_CHAT_ID=

# URL de la vista de mapa de Portal Inmobiliario con el polígono dibujado
URL_A_MONITOREAR=

# Nombre identificador de la propiedad, usado en los mensajes de notificación
NOMBRE_PROPIEDAD=

# Opcional: horas entre cada ejecución cuando se corre con el programador interno
# (scheduler.py / Docker). Default: 24. Ignorado si usas cron/launchd/Task Scheduler,
# y también ignorado si defines HORA_EJECUCION más abajo.
INTERVALO_HORAS=24

# Opcional: en vez de un intervalo, ejecuta una vez al día a esta hora exacta
# (formato "HH:MM", 24hs), en la zona horaria definida por TZ. Si la defines,
# INTERVALO_HORAS se ignora. Ejemplo: 09:00
HORA_EJECUCION=

# Zona horaria para HORA_EJECUCION (y para los timestamps de los logs).
# Nombres IANA, ej: America/Santiago, America/Mexico_City, Europe/Madrid.
# Default: UTC.
TZ=America/Santiago
