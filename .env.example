# Copia este archivo como .env y completa los valores reales.
# cp .env.example .env

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID donde se enviarán las notificaciones (obtenido con get_chat_id.py)
TELEGRAM_CHAT_ID=

# URL de la vista de mapa de Portal Inmobiliario con el polígono dibujado
URL_A_MONITOREAR=

# Nombre identificador de la propiedad, usado en los mensajes de notificación
NOMBRE_PROPIEDAD=
